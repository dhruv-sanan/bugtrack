generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  DEVELOPER
}

enum TicketStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

// Declared low to high so ORDER BY priority DESC returns HIGH first.
enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(DEVELOPER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     ProjectMember[]
  assignedTickets Ticket[]        @relation("TicketAssignee")
  reportedTickets Ticket[]        @relation("TicketReporter")
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  key         String   @unique
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members ProjectMember[]
  tickets Ticket[]
}

model ProjectMember {
  projectId Int
  userId    Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Ticket {
  id          Int            @id @default(autoincrement())
  title       String
  description String         @default("")
  status      TicketStatus   @default(TODO)
  priority    TicketPriority @default(MEDIUM)
  projectId   Int
  assigneeId  Int?
  reporterId  Int?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter User?   @relation("TicketReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([assigneeId])
}
