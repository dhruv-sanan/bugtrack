# Neon "pooled" connection string (hostname contains -pooler). Used by the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon "direct" connection string (no -pooler). Used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Generate with: openssl rand -base64 48
JWT_SECRET=""

# Base URL for links in emails. Use the Vercel URL in production.
APP_URL="http://localhost:3000"

# Optional. Without these, the app works and skips sending email.
# Gmail: enable 2-Step Verification, then create an App Password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""
